# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋되지 않는다(.gitignore).
# 이 값들은 API 프로세스의 환경변수로만 들어가며 브라우저로 전송되지 않는다.
# 어느 줄도 필수가 아니다 — 없는 자격증명은 그 단계만 막고, 화면이 어느 변수가
# 비었는지 말해 준다.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# 값은 = 뒤에 따옴표 없이 그대로 붙여넣는다. 앞뒤 공백과 감싼 따옴표는 제거되고,
# 메모장이 붙이는 BOM과 CRLF도 제거된다. 값 안의 공백은 보존된다.

# --- 규제기관 (0~1단계: 명단·Stage 0 적재) ---
# SEC는 키가 아니라 연락처를 요구한다. 공정이용 정책이 User-Agent에 연락처를
# 넣으라고 정하고 있고, 하네스는 당신이 설정하지 않은 연락처를 보내지 않는다.
SEC_USER_AGENT=Your Name your@email.com
# 무료 발급: https://opendart.fss.or.kr/
OPENDART_API_KEY=

# --- 시세 (2단계) ---
# 무료 티어로도 기준일 하나는 충분하다(한 세션 = 호출 1회).
# 발급: https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=
# polygon 대신 쓸 때만: https://eodhd.com/cp/dashboard
EODHD_API_KEY=

# --- 모델 (5~7단계: triage·full harness·심층 보고서) ---
# 비워 두면 유료 단계가 오프라인 스텁으로만 돈다 — 즉 돈이 나가지 않는다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- 선택 ---
# 작업 큐를 쓸 때만. 비우면 파일만으로 동작한다.
# HARNESS_DATABASE_URL=postgresql+psycopg://user:pass@host/harness
