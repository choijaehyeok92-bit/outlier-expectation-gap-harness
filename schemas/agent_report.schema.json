{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Report",
  "type": "object",
  "required": [
    "agent_id",
    "ticker",
    "as_of_date",
    "domain",
    "role",
    "analysis_status",
    "score_0_100",
    "confidence_0_1",
    "thesis",
    "evidence",
    "counterevidence",
    "unknowns",
    "falsifiers",
    "hard_veto_flags",
    "key_kpis",
    "next_checks",
    "verdict"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "analysis_status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "score_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence_0_1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "thesis": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_type",
          "source",
          "period",
          "as_of_date"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "as_of_date": {
            "type": "string"
          },
          "value": {},
          "fact_or_estimate": {
            "enum": [
              "fact",
              "estimate",
              "interpretation"
            ]
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hard_veto_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "veto",
          "status",
          "rationale"
        ],
        "properties": {
          "veto": {
            "type": "string"
          },
          "status": {
            "enum": [
              "none",
              "candidate",
              "conditional",
              "confirmed",
              "cleared"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "key_kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          }
        }
      }
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "support",
        "neutral",
        "oppose"
      ]
    },
    "archetype_signals": {
      "type": "object",
      "description": "종목 유형 분류용 밸류에이션 신호. expectation_valuation 도메인 에이전트가 작성하며 하네스는 중앙값을 사용한다.",
      "properties": {
        "price_to_base_value": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "현재 주가 / Base 시나리오 주당 내재가치"
        },
        "valuation_percentile_5y": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "핵심 밸류에이션 멀티플의 자기 5년 이력 대비 백분위 (0=최저)"
        },
        "revenue_cagr_next_3y": {
          "type": ["number", "null"],
          "description": "향후 3년 매출 CAGR Base 추정치 (0.12 = 12%)"
        }
      }
    },
    "risk_budget_multiplier": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  },
  "additionalProperties": true
}