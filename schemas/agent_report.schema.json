{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Report",
  "type": "object",
  "required": [
    "agent_id",
    "ticker",
    "as_of_date",
    "domain",
    "role",
    "analysis_status",
    "score_0_100",
    "confidence_0_1",
    "thesis",
    "evidence",
    "counterevidence",
    "unknowns",
    "falsifiers",
    "hard_veto_flags",
    "key_kpis",
    "next_checks",
    "verdict"
  ],
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "analysis_status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "score_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "confidence_0_1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bull_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "점수 도메인 필수: Bull 논리가 맞을 때의 도메인 점수"
    },
    "bear_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "점수 도메인 필수: Skeptic 논리가 맞을 때의 도메인 점수. bear_score ≤ score_0_100 ≤ bull_score"
    },
    "bull_case": {
      "type": "string",
      "maxLength": 300
    },
    "bear_case": {
      "type": "string",
      "maxLength": 300
    },
    "thesis": {
      "type": "string",
      "maxLength": 600
    },
    "evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_type",
          "source",
          "period",
          "as_of_date"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "as_of_date": {
            "type": "string"
          },
          "value": {},
          "fact_or_estimate": {
            "enum": [
              "fact",
              "estimate",
              "interpretation"
            ]
          },
          "evidence_id": {
            "type": "string"
          },
          "economic_driver": {
            "type": "string"
          }
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "falsifiers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "hard_veto_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "veto",
          "status",
          "rationale"
        ],
        "properties": {
          "veto": {
            "type": "string"
          },
          "status": {
            "enum": [
              "none",
              "candidate",
              "conditional",
              "confirmed",
              "cleared"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "elements_met": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "requires_element_assessment가 선언된 veto에서 confirmed·conditional을 쓸 때 필수. definitions의 elements를 하나도 빠뜨리지 않고 참/거짓으로 답한다."
          },
          "decisive_missing_evidence": {
            "type": "string",
            "description": "conditional일 때 필수. 미충족 구성요건 하나를 확정할 결정적 자료와 해소 조건."
          }
        }
      }
    },
    "key_kpis": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          },
          "cadence": {
            "type": "string"
          }
        }
      }
    },
    "next_checks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "support",
        "neutral",
        "oppose"
      ]
    },
    "archetype_signals": {
      "type": "object",
      "description": "레거시 호환 필드. 새 실행에서 price_to_base_value는 deterministic valuation 결과가 우선한다.",
      "properties": {
        "price_to_base_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "현재 주가 / Base 시나리오 주당 내재가치"
        },
        "valuation_percentile_5y": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "핵심 밸류에이션 멀티플의 자기 5년 이력 대비 백분위 (0=최저)"
        },
        "revenue_cagr_next_3y": {
          "type": [
            "number",
            "null"
          ],
          "description": "향후 3년 매출 CAGR Base 추정치 (0.12 = 12%)"
        }
      }
    },
    "risk_budget_multiplier": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "subscores": {
      "type": "array",
      "description": "점수 도메인에서 config/calibration.json의 criterion을 정확히 한 번씩 채운다.",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "score_0_100",
          "rationale"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "score_0_100": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "description": "문장 개수 대신 rubric criterion별 불확실성 severity를 기록한다.",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "severity",
          "rationale"
        ],
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "minor",
              "material",
              "critical"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "valuation_inputs": {
      "type": "object",
      "description": "EV 전용. 하네스가 고정 할인율/terminal multiple로 DCF를 재계산한다.",
      "properties": {
        "valuation_percentile_5y": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "revenue_cagr_next_3y": {
          "type": [
            "number",
            "null"
          ]
        },
        "scenarios": {
          "type": "object",
          "properties": {
            "bear": {
              "type": "object",
              "properties": {
                "owner_fcf_per_share": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "base": {
              "type": "object",
              "properties": {
                "owner_fcf_per_share": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "bull": {
              "type": "object",
              "properties": {
                "owner_fcf_per_share": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "geo_events_reviewed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "global_components": {
      "type": "object",
      "description": "Only global-scoped timestamped components. Runtime validates dimensions and TTLs.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "scope",
          "as_of_utc"
        ],
        "properties": {
          "scope": {
            "const": "global"
          },
          "as_of_utc": {
            "type": "string"
          },
          "risk_budget_multiplier": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "dimensions": {
            "type": "object"
          }
        }
      }
    },
    "plain_language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business": {
          "type": "string",
          "maxLength": 600
        },
        "opportunity": {
          "type": "string",
          "maxLength": 600
        },
        "risk": {
          "type": "string",
          "maxLength": 600
        },
        "decision_reason": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "dilution_metrics": {
      "type": "object",
      "description": "선택. 희석 watch 층의 입력. 하네스가 dilution_policy의 밴드로 분류한다. Hard Veto 판정이 아니며 점수를 바꾸지 않는다.",
      "properties": {
        "annualized_dilution": {
          "type": [
            "number",
            "null"
          ],
          "description": "연환산 희석주식수 증가율. 0.052 = 5.2%"
        },
        "three_year_diluted_share_cagr": {
          "type": [
            "number",
            "null"
          ]
        },
        "three_year_cumulative_dilution": {
          "type": [
            "number",
            "null"
          ]
        },
        "consecutive_years_material_dilution": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "per_share_value_proxy": {
          "type": [
            "string",
            "null"
          ],
          "description": "veto_criteria의 per_share_value_proxies 중 사용한 것"
        },
        "per_share_value_growth": {
          "type": [
            "number",
            "null"
          ],
          "description": "희석 기간 동안 그 proxy의 주당 증가율"
        },
        "structural_financing_need": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
