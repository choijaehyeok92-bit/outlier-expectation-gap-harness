{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Final IC Verdict",
  "type": "object",
  "required": [
    "ticker",
    "as_of_date",
    "score_100",
    "classification",
    "disruptive_innovation_score",
    "archetype",
    "hard_veto_status",
    "ic_state",
    "position_range",
    "domain_scores",
    "disputes",
    "falsifiers"
  ],
  "properties": {
    "ticker": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "score_100": {
      "type": "number"
    },
    "classification": {
      "type": "string"
    },
    "disruptive_innovation_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "archetype": {
      "enum": [
        "moonshot",
        "compounder",
        "emerging_outlier",
        "expectation_gap",
        "turnaround",
        "non_fit"
      ]
    },
    "secondary_archetypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "archetype_rationale": {
      "type": "string",
      "description": "기계적 유형과 다르게 판정했다면 그 근거"
    },
    "hard_veto_status": {
      "type": "string"
    },
    "ic_state": {
      "type": "string"
    },
    "position_range": {
      "type": "string"
    },
    "domain_scores": {
      "type": "object"
    },
    "disputes": {
      "type": "array"
    },
    "falsifiers": {
      "type": "array"
    },
    "macro_pacing_multiplier": {
      "type": "number"
    },
    "turnaround_quality_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "턴어라운드 품질 독립 평가축 점수 (100점 핵심 점수 비합산)"
    }
  }
}
