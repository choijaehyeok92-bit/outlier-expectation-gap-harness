{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3 deterministic final verdict and IC synthesis",
  "type": "object",
  "required": [
    "ticker",
    "as_of_date",
    "score_100",
    "classification",
    "disruptive_innovation_score",
    "archetype",
    "hard_veto_status",
    "ic_state",
    "position_range",
    "domain_scores",
    "disputes",
    "falsifiers",
    "strategy_version",
    "schema_version",
    "decision_policy_version",
    "archetype_fit",
    "early_exit_record",
    "ic_verdict",
    "macro_geo_overlay",
    "evidence_concentration_flags"
  ],
  "properties": {
    "ticker": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "score_100": {
      "type": [
        "number",
        "null"
      ]
    },
    "classification": {
      "type": "string"
    },
    "disruptive_innovation_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "archetype": {
      "enum": [
        "compounder",
        "buffett_value",
        "moonshot",
        "non_fit"
      ]
    },
    "secondary_archetypes": {
      "type": "array",
      "items": {
        "enum": [
          "compounder",
          "buffett_value",
          "moonshot"
        ]
      }
    },
    "archetype_rationale": {
      "type": "string",
      "description": "기계적 유형과 다르게 판정했다면 그 근거"
    },
    "hard_veto_status": {
      "type": "string"
    },
    "ic_state": {
      "type": "string"
    },
    "position_range": {
      "type": "string"
    },
    "domain_scores": {
      "type": "object"
    },
    "disputes": {
      "type": "array"
    },
    "falsifiers": {
      "type": "array"
    },
    "macro_pacing_multiplier": {
      "type": "number"
    },
    "turnaround_quality_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Optional normalization diagnostic, never an investable archetype or core score."
    },
    "strategy_version": {
      "const": "3.0"
    },
    "schema_version": {
      "const": "3.0"
    },
    "decision_policy_version": {
      "const": "3.0"
    },
    "archetype_fit": {
      "type": "object",
      "required": [
        "compounder",
        "buffett_value",
        "moonshot"
      ],
      "additionalProperties": false,
      "properties": {
        "compounder": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "buffett_value": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "moonshot": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "early_exit_record": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "stage",
        "last_reachable_archetypes",
        "eliminated_archetypes",
        "future_reentry",
        "ic_intentionally_not_run"
      ],
      "properties": {
        "ic_intentionally_not_run": {
          "const": true
        }
      }
    },
    "ic_verdict": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_concentration_flags": {
      "type": "array"
    },
    "macro_geo_overlay": {
      "type": "object",
      "required": [
        "financial_regime",
        "geopolitical_regime",
        "company_transmission",
        "purchase_pacing_multiplier",
        "fundamental_score_effect"
      ],
      "properties": {
        "fundamental_score_effect": {
          "const": 0
        },
        "purchase_pacing_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
