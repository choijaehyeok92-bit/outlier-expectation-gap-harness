{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V3.1 deterministic final verdict and IC synthesis",
  "type": "object",
  "required": [
    "ticker",
    "as_of_date",
    "score_100",
    "classification",
    "disruptive_innovation_score",
    "archetype",
    "hard_veto_status",
    "ic_state",
    "position_range",
    "domain_scores",
    "disputes",
    "falsifiers",
    "strategy_version",
    "schema_version",
    "decision_policy_version",
    "archetype_fit",
    "early_exit_record",
    "ic_verdict",
    "macro_geo_overlay",
    "evidence_concentration_flags"
  ],
  "properties": {
    "ticker": {
      "type": "string"
    },
    "as_of_date": {
      "type": "string"
    },
    "score_100": {
      "type": [
        "number",
        "null"
      ]
    },
    "classification": {
      "type": "string"
    },
    "disruptive_innovation_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "archetype": {
      "enum": [
        "compounder",
        "outlier_growth",
        "growth",
        "buffett_value",
        "moonshot",
        "non_fit"
      ]
    },
    "secondary_archetypes": {
      "type": "array",
      "items": {
        "enum": [
          "compounder",
          "outlier_growth",
          "growth",
          "buffett_value",
          "moonshot"
        ]
      }
    },
    "archetype_rationale": {
      "type": "string",
      "description": "기계적 유형과 다르게 판정했다면 그 근거"
    },
    "hard_veto_status": {
      "type": "string"
    },
    "ic_state": {
      "type": "string"
    },
    "position_range": {
      "type": "string"
    },
    "domain_scores": {
      "type": "object"
    },
    "disputes": {
      "type": "array"
    },
    "falsifiers": {
      "type": "array"
    },
    "macro_pacing_multiplier": {
      "type": "number"
    },
    "turnaround_quality_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Optional normalization diagnostic, never an investable archetype or core score."
    },
    "strategy_version": {
      "enum": [
        "3.1",
        "3.2",
        "3.3"
      ],
      "description": "지원 버전. v3.1·v3.2 산출물은 마이그레이션 없이 그대로 읽힌다."
    },
    "schema_version": {
      "enum": [
        "3.1",
        "3.2",
        "3.3"
      ],
      "description": "지원 버전. v3.1·v3.2 산출물은 마이그레이션 없이 그대로 읽힌다."
    },
    "decision_policy_version": {
      "enum": [
        "3.1",
        "3.2",
        "3.3"
      ],
      "description": "지원 버전. v3.1·v3.2 산출물은 마이그레이션 없이 그대로 읽힌다."
    },
    "archetype_fit": {
      "type": "object",
      "required": [
        "compounder",
        "growth",
        "buffett_value",
        "moonshot"
      ],
      "additionalProperties": false,
      "properties": {
        "compounder": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "buffett_value": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "moonshot": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "growth": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "outlier_growth": {
          "type": "object",
          "required": [
            "eligible",
            "fit_score",
            "failed_conditions",
            "missing_conditions",
            "blocking_vetoes"
          ],
          "properties": {
            "eligible": {
              "type": "boolean"
            },
            "fit_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "failed_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "missing_conditions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "blocking_vetoes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "early_exit_record": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "stage",
        "last_reachable_archetypes",
        "eliminated_archetypes",
        "future_reentry",
        "ic_intentionally_not_run"
      ],
      "properties": {
        "ic_intentionally_not_run": {
          "const": true
        }
      }
    },
    "ic_verdict": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_concentration_flags": {
      "type": "array"
    },
    "macro_geo_overlay": {
      "type": "object",
      "required": [
        "financial_regime",
        "geopolitical_regime",
        "company_transmission",
        "purchase_pacing_multiplier",
        "fundamental_score_effect"
      ],
      "properties": {
        "fundamental_score_effect": {
          "const": 0
        },
        "purchase_pacing_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "axis_scores": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      },
      "description": "독립 평가축 점수. 100점 핵심 점수에는 합산하지 않는다."
    },
    "dilution_watch": {
      "type": [
        "object",
        "null"
      ],
      "description": "희석 watch 상태. Hard Veto가 아니며 archetype을 제거하지 않는다. dilution_metrics를 선언한 보고서가 없으면 null이다(기존 run 호환).",
      "properties": {
        "status": {
          "enum": [
            "normal",
            "monitor",
            "elevated",
            "severe"
          ]
        },
        "position_cap": {
          "type": [
            "string",
            "null"
          ]
        },
        "position_before": {
          "type": "string"
        },
        "declared_by": {
          "type": "string"
        },
        "is_hard_veto": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "3.2",
              "3.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "archetype_fit": {
            "required": [
              "compounder",
              "outlier_growth",
              "growth",
              "buffett_value",
              "moonshot"
            ]
          }
        }
      },
      "description": "v3.2 이상 verdict는 다섯 유형 전부의 fit을 담아야 한다. v3.1 이하 산출물은 네 개만 있어도 유효하며 다시 쓰지 않는다."
    }
  ]
}
