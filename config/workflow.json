{
  "execution": {
    "unit": "agent",
    "unit_note": "항목(도메인)당 에이전트 1개, 에이전트당 호출 1회. 점수 도메인 에이전트는 Bull·Verifier·Skeptic 관점을 보고서 안에서 분리해 bull_score/bear_score로 남긴다.",
    "triage_domains": [
      "expectation_valuation",
      "asymmetry",
      "disruptive_innovation",
      "financial_survival"
    ],
    "early_exit": true,
    "early_exit_rule": "Complete universal triage; assume unfinished domains attainable. Exit if no v3 archetype can reach its conditions and optimistic core gate. Known unresolved vetoes require review, not premature elimination.",
    "research_budget": {
      "per_agent_web_calls": 15
    },
    "report_limits": {
      "thesis_chars": 600,
      "case_chars": 300,
      "evidence": [
        3,
        6
      ],
      "counterevidence": 4,
      "unknowns": 5,
      "falsifiers": 3,
      "key_kpis": 3,
      "next_checks": 3
    },
    "phase3_and_ic_inputs": [
      "digest.md",
      "aggregate.json"
    ],
    "research_policy": {
      "mode": "active_gap_filling",
      "prompt_line": "자료 공백은 수동적으로 남기지 않는다. 점수·Veto·밸류에이션에 직접 영향을 주는 항목이 기준 정보와 1차 자료에 없으면 예산 내에서 웹 검색·IR·2차 자료로 보완을 시도한 뒤, 그래도 확보하지 못한 것만 unknowns에 남기고 무엇을 어디서 찾으려 했는지 함께 적는다. 확보한 자료는 evidence에 source_type과 함께 기록하고 EVIDENCE_POLICY.md의 출처 위계를 지킨다.",
      "rules": [
        "점수·Veto·밸류에이션을 좌우하는 공백을 우선 보완한다.",
        "보완 시도 후에도 없으면 unknowns에 남기되 시도한 경로를 적는다.",
        "2차 자료로 채운 값은 fact_or_estimate를 estimate 또는 interpretation으로 표기한다.",
        "기준 정보와 sources/README.md에 이미 있는 사실은 재검색하지 않는다."
      ]
    },
    "overlay_policy": {
      "component_ttl_hours": {
        "financial_conditions": 72,
        "credit_liquidity": 72,
        "geopolitical_events": 24,
        "structural_trade": 168
      },
      "geopolitical_dimensions": {
        "geopolitical_events": [
          "military_conflict",
          "energy_disruption",
          "shipping_disruption",
          "sovereign_policy_instability"
        ],
        "structural_trade": [
          "trade_fragmentation",
          "export_controls",
          "sanctions"
        ]
      },
      "severity_multipliers": {
        "low": 1.0,
        "moderate": 0.8,
        "high": 0.5,
        "critical": 0.25,
        "unknown": 0.5
      },
      "missing_component_multiplier": 0.5,
      "transmission_fields": {
        "military_conflict": [
          "revenue_by_region",
          "production_by_region",
          "critical_supplier_regions",
          "government_customer_exposure"
        ],
        "trade_fragmentation": [
          "revenue_by_region",
          "production_by_region"
        ],
        "export_controls": [
          "export_control_dependencies",
          "revenue_by_region",
          "production_by_region",
          "critical_supplier_regions"
        ],
        "sanctions": [
          "sanctions_exposure",
          "revenue_by_region",
          "production_by_region",
          "critical_supplier_regions",
          "government_customer_exposure"
        ],
        "energy_disruption": [
          "production_by_region",
          "critical_supplier_regions"
        ],
        "shipping_disruption": [
          "critical_shipping_routes"
        ],
        "sovereign_policy_instability": [
          "revenue_by_region",
          "production_by_region",
          "government_customer_exposure"
        ]
      },
      "structural_routes": {
        "permanent_export_ban": [
          "structural_leadership",
          "customer_product",
          "financial_survival"
        ],
        "durable_market_access_loss": [
          "structural_leadership",
          "customer_product",
          "moat_trajectory",
          "financial_survival"
        ],
        "sanctions": [
          "customer_product",
          "financial_survival"
        ],
        "nationalization": [
          "moat_trajectory",
          "financial_survival"
        ],
        "critical_supplier_loss": [
          "customer_product",
          "moat_trajectory",
          "financial_survival"
        ]
      }
    }
  },
  "phases": [
    {
      "phase": 0,
      "name": "intake",
      "outputs": [
        "company_context.json",
        "sources/README.md",
        "sources/INDEX.md"
      ]
    },
    {
      "phase": "1a",
      "name": "triage",
      "agents": [
        "EV",
        "AS",
        "DI",
        "FS"
      ],
      "gate": "harness.py plan — 도달 가능한 유형이 없으면 조기 종료"
    },
    {
      "phase": "1b",
      "name": "domain_analysis",
      "agents": [
        "SL",
        "CP",
        "MT",
        "RF",
        "MA"
      ],
      "note": "DI is an independent axis; TQ is optional when diagnostics.turnaround_candidate is true."
    },
    {
      "phase": 2,
      "name": "in_report_cross_examination",
      "rule": "각 도메인 에이전트가 bull_case/bear_case와 bull_score/bear_score로 관점 충돌을 기록한다. 점수차 20 이상은 분쟁, 30 이상은 재조사."
    },
    {
      "phase": 3,
      "name": "evidence_audit_and_red_team",
      "agents": [
        "ED",
        "RT"
      ],
      "inputs": "digest.md (원 보고서 전체 재독 금지)"
    },
    {
      "phase": 4,
      "name": "hard_veto_gate",
      "rule": "confirmed or unresolved candidate => no automatic buy approval"
    },
    {
      "phase": 5,
      "name": "score_archetype_and_ic",
      "archetypes": [
        "compounder",
        "outlier_growth",
        "growth",
        "buffett_value",
        "moonshot",
        "non_fit"
      ],
      "rule": "Deterministic eligible fit ranking; IC tests the strongest objections and cannot bypass gates.",
      "agents": [
        "IC"
      ],
      "note": "다섯 개의 투자 가능 유형과 시스템 상태 non_fit. 목록은 config/strategy.json의 archetypes와 일치해야 하며, 문서가 실행 config와 갈라지지 않게 한다."
    },
    {
      "phase": 6,
      "name": "macro_overlay",
      "agents": [
        "MO"
      ],
      "score_effect": 0,
      "pacing_only": true,
      "cache": "Timestamped global components only, with component_ttl_hours. Company transmission is recomputed per run."
    },
    {
      "phase": 7,
      "name": "position_and_monitoring",
      "outputs": [
        "position_range",
        "increase_evidence",
        "sell_evidence",
        "quarterly_kpis",
        "annual_rewrite_date"
      ]
    }
  ]
}