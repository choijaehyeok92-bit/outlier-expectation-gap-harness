{
  "schema_version": "1.0",
  "note": "결정론적 스크리닝 지표 정의. 계산은 전부 Python이 하며 LLM은 이 파일도 이 계산도 건드리지 않는다. 각 지표는 표현식 트리이고, 트리는 (기준일 TTM) 또는 (회계연도) 문맥에서 평가된다. 구성요소가 하나라도 없으면 결과는 0이 아니라 미상(null)이며 그 사유가 함께 기록된다.",
  "fact_selection": {
    "consolidated_segment_labels": [
      "consolidated",
      "total",
      "total company",
      "company",
      "연결",
      "합계",
      "전사"
    ],
    "exclude_statements": [
      "segment"
    ],
    "require_filing_date_at_or_before_as_of": true,
    "flag_conflicting_values": true,
    "note": "세그먼트 행은 전사 합계가 아니다. segment가 비어 있거나 연결/합계로 선언된 fact만 쓴다. 이 필터가 없으면 \"Revenue by geography — APAC\"이 같은 기간의 마지막 행이라는 이유만으로 전사 매출로 읽혀 매출총이익률이 2000%로 나온다. 실제 run 데이터에서 발생한 사례다. 같은 기간에 서로 다른 연결 값이 남으면 최신 제출을 쓰고 대안을 리뷰로 올린다."
  },
  "ttm_policy": {
    "methods": [
      "four_quarters",
      "fy_ytd_bridge",
      "latest_fy"
    ],
    "never_mix_period_kinds": true,
    "max_gap_days": 10,
    "max_staleness_days": 420,
    "note": "TTM은 두 방법 중 성립하는 첫 번째로 계산한다. (1) four_quarters: 마감일 이전 연속된 분기 fact 4개의 합. 사이가 끊기면 쓰지 않는다. (2) fy_ytd_bridge: 직전 FY + 당기 누계 − 전년 동기 누계. 두 누계의 개월수가 같아야 한다. 한국 현금흐름표처럼 누계만 공시하는 계정은 (2)만 성립한다. 분기와 누계를 같은 합에 섞지 않는다. (3) latest_fy: 중간보고 이후 자료가 없고 최근 사업연도가 마감일 이전에 끝났다면 그 FY를 TTM으로 쓴다. max_staleness_days를 넘긴 창은 쓰지 않는다."
  },
  "per_share": {
    "denominators": [
      "diluted_weighted_average_shares",
      "basic_weighted_average_shares",
      "period_end_shares"
    ],
    "note": "희석 가중평균주식수를 우선한다. 없으면 기본 가중평균, 그것도 없으면 기말 발행주식수를 쓰고 어느 것을 썼는지 기록한다. 주식수가 없으면 주당 지표는 미상이다."
  },
  "components": {
    "total_debt": {
      "prefer": [
        "total_debt"
      ],
      "sum_of": [
        {
          "metric": "short_term_debt",
          "required": true
        },
        {
          "metric": "long_term_debt",
          "required": true
        },
        {
          "metric": "convertible_debt",
          "required": false
        }
      ],
      "excluded": [
        "lease_liabilities"
      ],
      "excluded_note": "리스부채를 차입금에 포함할지는 경제적 판단이라 기본 정의에서 제외한다. 포함하려면 이 파일에서 옮긴다."
    },
    "cash_and_investments": {
      "sum_of": [
        {
          "metric": "cash",
          "required": true
        },
        {
          "metric": "short_term_investments",
          "required": false
        },
        {
          "metric": "long_term_investments",
          "required": false
        }
      ],
      "note": "현금은 필수다. 투자자산 항목이 공시에 없으면 0으로 더하되 assumptions에 기록한다 — 없는 줄과 0인 줄을 구분해 남긴다."
    }
  },
  "definitions": [
    {
      "id": "revenue_ttm",
      "kind": "ttm",
      "source_metric": "revenue",
      "unit": "local_currency"
    },
    {
      "id": "cost_of_revenue_ttm",
      "kind": "ttm",
      "source_metric": "cost_of_revenue",
      "internal": true
    },
    {
      "id": "gross_profit_ttm",
      "kind": "ttm",
      "source_metric": "gross_profit",
      "unit": "local_currency",
      "fallback": {
        "kind": "difference",
        "minuend": "revenue_ttm",
        "subtrahend": "cost_of_revenue_ttm"
      },
      "fallback_note": "매출총이익을 따로 공시하지 않는 기업이 많아 매출-매출원가로 대체한다."
    },
    {
      "id": "operating_income_ttm",
      "kind": "ttm",
      "source_metric": "operating_income",
      "internal": true
    },
    {
      "id": "ocf_ttm",
      "kind": "ttm",
      "source_metric": "operating_cash_flow",
      "unit": "local_currency"
    },
    {
      "id": "capex_ttm",
      "kind": "ttm",
      "source_metric": "capex",
      "internal": true
    },
    {
      "id": "sbc_ttm",
      "kind": "ttm",
      "source_metric": "sbc",
      "internal": true
    },
    {
      "id": "rnd_ttm",
      "kind": "ttm",
      "source_metric": "r_and_d",
      "internal": true
    },
    {
      "id": "owner_fcf_ttm",
      "kind": "difference",
      "minuend": "ocf_ttm",
      "subtrahend": "capex_ttm",
      "unit": "local_currency",
      "is_proxy": true,
      "proxy_note": "스크리닝용 기계적 대용치다: 영업현금흐름 − 자본적지출. 하네스 EV 에이전트가 쓰는 정상화 owner FCF는 유지보수 capex·일회성 항목에 대한 경제적 판단이 들어간 다른 수치이며, 이 값이 그것을 대신하지 않는다."
    },
    {
      "id": "cash_and_investments",
      "kind": "component",
      "component": "cash_and_investments",
      "internal": true
    },
    {
      "id": "total_debt_resolved",
      "kind": "component",
      "component": "total_debt",
      "internal": true
    },
    {
      "id": "net_cash",
      "kind": "difference",
      "minuend": "cash_and_investments",
      "subtrahend": "total_debt_resolved",
      "unit": "local_currency"
    },
    {
      "id": "net_cash_per_share",
      "kind": "per_share",
      "metric": "net_cash",
      "unit": "local_currency",
      "denominator_preference": [
        "period_end_shares",
        "diluted_weighted_average_shares",
        "basic_weighted_average_shares"
      ],
      "denominator_note": "재무상태표 항목의 주당 값이므로 기말 발행주식수를 우선한다. 가중평균은 기간 평균이라 시점 잔액과 짝이 맞지 않는다."
    },
    {
      "id": "gross_margin",
      "kind": "ratio",
      "numerator": "gross_profit_ttm",
      "denominator": "revenue_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "operating_margin",
      "kind": "ratio",
      "numerator": "operating_income_ttm",
      "denominator": "revenue_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "owner_fcf_margin",
      "kind": "ratio",
      "numerator": "owner_fcf_ttm",
      "denominator": "revenue_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "sbc_to_revenue",
      "kind": "ratio",
      "numerator": "sbc_ttm",
      "denominator": "revenue_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "rnd_to_revenue",
      "kind": "ratio",
      "numerator": "rnd_ttm",
      "denominator": "revenue_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "capex_to_ocf",
      "kind": "ratio",
      "numerator": "capex_ttm",
      "denominator": "ocf_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "debt_to_ocf",
      "kind": "ratio",
      "numerator": "total_debt_resolved",
      "denominator": "ocf_ttm",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    },
    {
      "id": "owner_fcf_per_share",
      "kind": "per_share",
      "metric": "owner_fcf_ttm",
      "unit": "local_currency"
    },
    {
      "id": "gross_profit_per_share",
      "kind": "per_share",
      "metric": "gross_profit_ttm",
      "unit": "local_currency"
    },
    {
      "id": "diluted_shares",
      "kind": "ttm_average",
      "source_metric": "diluted_weighted_average_shares",
      "internal": true
    },
    {
      "id": "revenue_growth_yoy",
      "kind": "growth",
      "metric": "revenue_ttm",
      "basis": "ttm",
      "years": 1,
      "unit": "ratio"
    },
    {
      "id": "diluted_share_growth_yoy",
      "kind": "growth",
      "metric": "diluted_shares",
      "basis": "fy",
      "years": 1,
      "unit": "ratio"
    },
    {
      "id": "revenue_cagr_3y",
      "kind": "cagr",
      "metric": "revenue_ttm",
      "basis": "fy",
      "years": 3,
      "unit": "ratio"
    },
    {
      "id": "owner_fcf_per_share_cagr_3y",
      "kind": "cagr",
      "metric": "owner_fcf_per_share",
      "basis": "fy",
      "years": 3,
      "unit": "ratio"
    },
    {
      "id": "gross_profit_per_share_cagr_3y",
      "kind": "cagr",
      "metric": "gross_profit_per_share",
      "basis": "fy",
      "years": 3,
      "unit": "ratio"
    },
    {
      "id": "diluted_share_cagr_3y",
      "kind": "cagr",
      "metric": "diluted_shares",
      "basis": "fy",
      "years": 3,
      "unit": "ratio"
    },
    {
      "id": "market_cap",
      "kind": "market",
      "field": "market_cap",
      "unit": "local_currency"
    },
    {
      "id": "current_price",
      "kind": "market",
      "field": "close",
      "unit": "local_currency"
    },
    {
      "id": "price_to_owner_fcf",
      "kind": "ratio",
      "numerator": "current_price",
      "denominator": "owner_fcf_per_share",
      "denominator_must_be_positive": true,
      "unit": "ratio"
    }
  ],
  "cagr_policy": {
    "require_positive_endpoints": true,
    "note": "시작값이 0 이하이면 CAGR은 수학적으로 정의되지 않는다. 부호를 무시한 값을 만들어내지 않고 미상으로 남긴다."
  },
  "growth_policy": {
    "require_positive_base": true,
    "note": "기준값이 0 이하이면 증가율을 만들지 않는다. 적자에서 적자 축소를 몇 퍼센트 성장으로 보고하면 스크린이 거짓말을 한다."
  }
}
