__pycache__/
*.py[cod]

# web application
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# generated run artifacts; reproducible from the CLI, persisted to DB/object
# storage from Phase 2. A fixture-derived deep dive is not research and does
# not belong in the analytical record under runs/.
screen_runs/
deep_dive/
triage_runs/
full_harness_runs/
# Evaluated monitoring snapshots are recomputable from the observation log and
# the reports. `monitoring/` is NOT ignored: an observation is what somebody
# saw, and nothing can regenerate that.
monitoring_runs/

# adapter working data: corpCode cache, synced universe, market CSVs.
# Regenerated by `harness.py universe sync`; the regulators are the source.
data/

# credentials, read by scripts/start.* into the API process's environment.
# .env.example is the committed template; .env is the machine's own secret.
.env
.env.local
